#!/bin/bash
set -uo pipefail

WORK_DIR=/var/lib/snapshot-recert
CRYPTO_DIR=${WORK_DIR}/crypto
NMSTATE_FILE=${WORK_DIR}/nmstate.yaml
UPLINK_MAC_FILE=${WORK_DIR}/uplink.mac
MARKER_DIR=${WORK_DIR}/markers

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') snapshot-recert: $*"; }

run_once() {
  local name="$1"
  shift
  if [[ -f "${MARKER_DIR}/${name}.done" ]]; then
    log "Skipping ${name} (already completed)"
    return 0
  fi
  log "Running ${name}"
  if "$@"; then
    touch "${MARKER_DIR}/${name}.done"
    log "Completed ${name}"
    return 0
  else
    log "Failed ${name}"
    return 1
  fi
}

mkdir -p "${MARKER_DIR}"

# --- Apply network configuration ---
apply_nmstate() {
  local expected_mac address_file actual_mac iface match_count=0 status
  expected_mac=$(<"${UPLINK_MAC_FILE}") || return 1
  expected_mac=${expected_mac,,}
  for address_file in /sys/class/net/*/address; do
    actual_mac=$(<"${address_file}") || continue
    if [[ ${actual_mac,,} == "${expected_mac}" ]]; then
      iface=${address_file%/address}
      iface=${iface##*/}
      ((match_count += 1))
    fi
  done
  if (( match_count != 1 )); then
    log "Could not identify exactly one guest interface for the OCP uplink"
    return 1
  fi
  if [[ ! ${iface} =~ ^[a-zA-Z0-9_.:-]+$ ]]; then
    log "The discovered OCP uplink interface name is invalid"
    return 1
  fi
  sed "s/__OCP_UPLINK_INTERFACE__/${iface}/g" "${NMSTATE_FILE}" > "${WORK_DIR}/nmstate.resolved.yaml"
  log "Applying OCP uplink network configuration"
  if nmstatectl apply "${WORK_DIR}/nmstate.resolved.yaml" >/dev/null 2>&1; then
    return 0
  else
    status=$?
  fi
  log "Failed to apply OCP uplink network configuration (exit status ${status})"
  return "$status"
}
run_once "nmstate" apply_nmstate || exit 1

# --- Clean CRI-O pod state from snapshot ---
clean_crio() {
  crictl stop --timeout 5 $(crictl ps -q 2>/dev/null) 2>/dev/null || true
  crictl pods -q 2>/dev/null | xargs --no-run-if-empty crictl rmp -f 2>/dev/null || true
  systemctl stop crio.service
}
run_once "crio-clean" clean_crio

# --- Run recert with standalone etcd ---
run_recert() {
  log "Reading etcd image from static pod manifest"
  local etcd_image
  etcd_image=$(python3 -c "
import yaml
d = yaml.safe_load(open('/etc/kubernetes/manifests/etcd-pod.yaml'))
print([c['image'] for c in d['spec']['containers'] if c['name'] == 'etcd'][0])
")

  cleanup_etcd() {
    podman stop etcd-recert 2>/dev/null || true
    podman rm etcd-recert 2>/dev/null || true
  }
  trap cleanup_etcd RETURN

  log "Starting standalone etcd container"
  podman run -d --name etcd-recert \
    --network host --privileged --replace \
    --pull=never \
    --authfile /var/lib/kubelet/config.json \
    -v /var/lib/etcd:/store \
    --entrypoint etcd \
    "${etcd_image}" \
    --name editor --data-dir /store \
    --listen-client-urls http://localhost:2379 \
    --advertise-client-urls http://localhost:2379

  log "Waiting for etcd to be healthy"
  local retries=0
  until curl -sf http://localhost:2379/health; do
    retries=$((retries + 1))
    if [[ $retries -ge 30 ]]; then
      log "etcd failed to become healthy after 30 attempts"
      return 1
    fi
    sleep 2
  done

  log "Deleting HyperShift secrets from etcd"
  podman exec etcd-recert etcdctl del /kubernetes.io/secrets/hypershift/ --prefix || true
  podman exec etcd-recert etcdctl del /kubernetes.io/validatingwebhookconfigurations/hypershift.openshift.io || true
  podman exec etcd-recert etcdctl del /kubernetes.io/mutatingwebhookconfigurations/hypershift.openshift.io || true
  podman exec etcd-recert etcdctl del /kubernetes.io/secrets/open-cluster-management-agent-addon/hypershift-addon-agent-metrics || true
  podman exec etcd-recert etcdctl del /kubernetes.io/secrets/open-cluster-management-agent-addon/hypershift-addon-hub-kubeconfig || true

  log "Building recert config"
  python3 -c "
import json
config = {
    'etcd_endpoint': 'localhost:2379',
    'crypto_dirs': ['/etc/kubernetes', '/var/lib/kubelet', '/etc/machine-config-daemon', '/etc/cni'],
    'crypto_files': ['/host-etc/mcs-machine-config-content.json'],
    'cluster_customization_dirs': ['/etc/kubernetes', '/var/lib/kubelet', '/etc/machine-config-daemon'],
    'cluster_customization_files': ['/host-etc/mcs-machine-config-content.json', '/host-etc/mco/proxy.env', '/host-etc/chrony.conf'],
    'use_key_rules': [
        'kube-apiserver-lb-signer /tmp/crypto/lb-signer.key',
        'kube-apiserver-localhost-signer /tmp/crypto/localhost-signer.key',
        'kube-apiserver-service-network-signer /tmp/crypto/service-network-signer.key',
        '{{ _ingress_cn }} /tmp/crypto/ingress.key',
    ],
    'pull_secret': open('${CRYPTO_DIR}/pull-secret').read().strip(),
    'cluster_rename': '{{ ocp_cluster_name }}:{{ ocp_base_domain }}',
    'hostname': '{{ ocp_vm_name }}',
    'ip': ['{{ ocp_node_ip }}'],
    'cn_san_replace_rules': [
        'api.{{ snapshot_source_cluster }}.{{ snapshot_source_domain }},api.{{ ocp_cluster_name }}.{{ ocp_base_domain }}',
        'api-int.{{ snapshot_source_cluster }}.{{ snapshot_source_domain }},api-int.{{ ocp_cluster_name }}.{{ ocp_base_domain }}',
        '*.apps.{{ snapshot_source_cluster }}.{{ snapshot_source_domain }},*.apps.{{ ocp_cluster_name }}.{{ ocp_base_domain }}',
        '{{ snapshot_source_hostname }},{{ ocp_vm_name }}',
        'system:node:{{ snapshot_source_hostname }},system:node:{{ ocp_vm_name }}',
        '{{ snapshot_source_ip }},{{ ocp_node_ip }}',
    ],
    'extend_expiration': True,
    'summary_file_clean': '/var/tmp/recert-summary.yaml',
}
json.dump(config, open('${WORK_DIR}/recert_config.json', 'w'))
"

  log "Running recert"
  podman run --rm --name recert --pull=missing \
    --network host --privileged \
    -v /etc:/host-etc \
    -v /etc/kubernetes:/etc/kubernetes \
    -v /var/lib/kubelet:/var/lib/kubelet \
    -v /etc/machine-config-daemon:/etc/machine-config-daemon \
    -v /etc/cni:/etc/cni \
    -v /var/tmp:/var/tmp \
    -v "${CRYPTO_DIR}":/tmp/crypto:ro \
    -v "${WORK_DIR}/recert_config.json":/recert_config.json:ro \
    -e RECERT_CONFIG=/recert_config.json \
    {{ snapshot_recert_image }}

  log "Stopping standalone etcd"
  cleanup_etcd
  trap - RETURN
}
run_once "recert" run_recert

# --- Start services ---
start_services() {
  log "Starting CRI-O"
  systemctl start crio.service

  log "Restoring and starting kubelet"
  mv /etc/systemd/system/kubelet.service.snapshot-disabled /etc/systemd/system/kubelet.service
  systemctl daemon-reload
  systemctl enable --now kubelet

  log "Touching static pod manifests to force recreation"
  find /etc/kubernetes/manifests -name '*.yaml' -exec touch {} + 2>/dev/null || true
}
run_once "start-services" start_services

log "Recert complete"
